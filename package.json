{
  "name": "offersflow",
  "version": "1.0.0",
  "description": "OffersFlow - Monorepo with Next.js frontend and NestJS backend",
  "private": true,
  "packageManager": "pnpm@7.33.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@types/react": "18.2.37"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "pnpm --filter backend prisma generate",
    "db:seed": "pnpm --filter backend prisma db seed",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f postgres",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:push": "pnpm --filter backend prisma db push",
    "db:studio": "pnpm --filter backend prisma studio",
    "db:migrate:dev": "pnpm --filter backend prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter backend prisma migrate deploy"
  },
  "devDependencies": {
    "prettier": "3.0.0",
    "turbo": "latest",
    "typescript": "5.4.5"
  }
}
