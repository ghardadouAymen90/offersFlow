datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
}

model User {
  id            String         @id @default(uuid())
  fullName      String
  gender        String
  age           Int
  email         String         @unique
  password      String

  subscriptions Subscription[]
  payments      Payment[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Offer {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Int
  minutes     String   @default("")
  texts       String   @default("")
  data        String   @default("")

  isForFirstSubscription Boolean @default(false)
  isForSwitch            Boolean @default(true)
  isForReSubscription    Boolean @default(true)

  // Optional: store advantages as JSON (flexible)
  advantages Json

  subscriptions Subscription[]

  createdAt DateTime @default(now())
}

model Subscription {
  id        String              @id @default(uuid())
  userId    String
  offerId   String
  status    SubscriptionStatus  @default(ACTIVE)
  startedAt DateTime            @default(now())
  endedAt   DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, status])
}

model Payment {
  id            String   @id @default(uuid())

  userId        String
  subscriptionId String? @unique

  email         String
  address       String
  phoneNumber   String
  cardLastFour  String   // Only store last 4 digits for security

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}