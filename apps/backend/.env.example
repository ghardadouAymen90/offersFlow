PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/offersflow_db"
NODE_ENV=development

# Logging configuration
# Options: debug, info (default), warn, error
# debug: Shows all logs including stack traces
# info: Shows info/warn/error logs, no stack traces for client errors (4xx)
# warn: Shows only warn/error logs
# error: Shows only error logs
LOG_LEVEL=info
